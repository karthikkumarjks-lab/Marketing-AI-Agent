// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id                String   @id @default(cuid())
  name              String
  industry          String?
  objective         String?
  monthlyBudget     Int?
  currency          String   @default("USD")
  country           String?
  websiteUrl        String?
  icpNotes          String?
  currentChannels   String?
  marketingAssets   String?

  // Company DNA — economics, targets, and guardrails. All optional: agents
  // are instructed to state an assumption when a field is blank rather than
  // silently defaulting (e.g. never assume CAC is the target metric).
  aov               Int?     // average order/contract value, in workspace currency
  ltv               Int?     // customer lifetime value, in workspace currency
  grossMarginPct    Int?     // 0-100
  salesCycleDays    Int?
  salesCapacity     String?  // free text, e.g. "1 owner, no dedicated sales team"
  cacTarget         Int?
  cplTarget         Int?
  roasTarget        Float?
  revenueTarget     Int?
  conversionTarget  String?  // free text — often a % or count with a timeframe
  retentionTarget   String?
  northStarKpi      String?  // what the whole team is actually optimizing for
  guardrails        String?  // free text hard limits, e.g. "never exceed CAC of X"
  seasonality       String?
  existingStack     String?  // CRM/tools already in use
  maturityStage     String?  // e.g. "pre-launch", "early traction", "scaling"

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  agentRuns         AgentRun[]
  needsAnalyses     NeedsAnalysis[]
  brandDna          BrandDNA?
  integrations      Integration[]
  leads             Lead[]
  pipelineStages    PipelineStage[]
  customFieldDefs   CustomFieldDef[]
  workflowRules     WorkflowRule[]
}

// Connector status per workspace. No live OAuth flow exists yet — this
// persists which providers a workspace intends to use and whatever account
// label a human enters after connecting manually. See lib/integrations.ts
// for the provider registry and what real OAuth wiring would still need.
model Integration {
  id                String    @id @default(cuid())
  workspaceId       String
  provider          String // matches a key in lib/integrations.ts's INTEGRATION_PROVIDERS
  status            String    @default("not_connected") // "not_connected" | "connected"
  accountLabel      String? // free text, e.g. "Acme Co — 123-456-7890" — entered by hand, not fetched
  connectedAt       DateTime?
  // Real OAuth fields — only populated for providers with a live connection
  // wired (Meta Ads first). Stored in plaintext in the local SQLite file,
  // matching this app's existing security model (no auth system, API keys
  // already live in plaintext .env.local) — acceptable for a local
  // single-user tool, revisit before any multi-user/hosted deployment.
  accessToken       String? // long-lived Meta user access token
  tokenExpiresAt    DateTime?
  externalAccountId String? // e.g. Meta ad account id "act_123456789", chosen by the user post-connect
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
}

model BrandDNA {
  id               String   @id @default(cuid())
  workspaceId      String   @unique
  primaryColor     String?
  secondaryColor   String?
  accentColor      String?
  typography       String?
  visualStyle      String?
  brandPersonality String?
  toneOfVoice      String?
  positioning      String?
  approvedClaims   String?
  restrictedClaims String?
  dos              String?
  donts            String?
  updatedAt        DateTime @updatedAt

  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Agent {
  id              String  @id @default(cuid())
  key             String  @unique
  name            String
  category        String
  mission         String
  inputsSpec      String // JSON-encoded string[]
  outputsSpec     String // JSON-encoded string[]
  triggerNotes    String?
  isWired         Boolean @default(false)
  sortOrder       Int     @default(0)
  // Selling price in INR (whole rupees), set via the pricing admin page —
  // never written by the catalog seed, so re-seeding after a catalog change
  // never overwrites a price Karthikeyan has set. Null until priced.
  priceInr        Int?

  agentRuns       AgentRun[]
  needsAnalyses   NeedsAnalysis[]
}

enum OutcomeStatus {
  pending
  matched
  missed
}

model AgentRun {
  id               String        @id @default(cuid())
  workspaceId      String
  agentId          String
  status           String        @default("completed")
  inputContext     String // JSON-encoded snapshot of the Company DNA used
  outputMarkdown   String
  predictedOutcome String?
  actualOutcome    String?
  outcomeStatus    OutcomeStatus @default(pending)
  isDemo           Boolean       @default(false)
  model            String?
  // Optional link to the CRM lead this run was performed against/for (e.g.
  // running Lead Nurturing Strategy for one specific real lead). Null for
  // every workspace-level run that isn't about one particular lead.
  leadId           String?
  createdAt        DateTime      @default(now())

  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent            Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  lead             Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
}

model NeedsAnalysis {
  id                  String   @id @default(cuid())
  workspaceId         String
  agentId             String
  recommendedStatus   String // "active" | "idle"
  tier                String   @default("idle") // "mandatory" | "conditional" | "idle"
  reason              String
  evidence            String?  // JSON-encoded string[] — the specific DNA facts behind the call
  reactivationTrigger String?  // what DNA change would flip this from idle to active
  overriddenStatus    String? // manual override, if any
  createdAt           DateTime @default(now())

  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent                Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, agentId])
}

// ===================== CRM =====================
// A real (not advisory-only) CRM data layer: leads, pipeline stages, custom
// fields per workspace/industry, a timeline of real activity per lead, and
// event-triggered automation rules. Every one of the 137 agents can be run
// against a specific lead (see AgentRun.leadId above); workflow rules react
// to real changes in this data (see WorkflowRule below), including
// triggering an agent run as an action — the bridge between the CRM and the
// existing agent catalog.

model PipelineStage {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  order       Int      @default(0)
  isWon       Boolean  @default(false)
  isLost      Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads       Lead[]

  @@unique([workspaceId, name])
}

// Dynamic per-workspace fields so the CRM works for any industry (a real
// estate workspace needs "property interest", a SaaS workspace needs
// "seat count" — neither belongs as a fixed column). Values are stored on
// Lead.customFields as JSON keyed by this def's `key`.
model CustomFieldDef {
  id          String   @id @default(cuid())
  workspaceId String
  entity      String // "lead" — the only entity type in v1
  key         String // machine key, e.g. "preferred_contact_time"
  label       String // display label, e.g. "Preferred Contact Time"
  fieldType   String // "text" | "number" | "date" | "boolean" | "select"
  options     String? // JSON-encoded string[] — only meaningful for "select"
  isRequired  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, entity, key])
}

// A lead doubles as a lightweight deal for v1 (dealValue + stage) rather
// than a separate Deal model — keeps the object model simple until real
// usage shows a workspace needs multiple deals per contact.
model Lead {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  email        String?
  phone        String?
  company      String?
  source       String? // free text: "website form", "referral", "cold outbound", etc.
  stageId      String?
  score        Int? // 0-100 — set manually; no scoring agent wired to this yet
  dealValue    Int? // in workspace currency
  ownerName    String? // free text — no user/auth system exists yet, so no real assignment
  customFields String   @default("{}") // JSON-encoded {fieldKey: value}
  tags         String   @default("[]") // JSON-encoded string[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stage        PipelineStage?   @relation(fields: [stageId], references: [id])
  activities   LeadActivity[]
  agentRuns    AgentRun[]
  workflowLogs WorkflowRunLog[]

  @@index([workspaceId])
}

// The Lead Journey view's timeline. "email"/"sms"/"call" activities are
// only ever created by a workflow action or entered by hand in v1 — there
// is no connected email/SMS/telephony provider yet, so nothing here is
// fabricated from a live send that didn't happen.
model LeadActivity {
  id         String   @id @default(cuid())
  leadId     String
  type       String // "note" | "email" | "sms" | "call" | "stage_change" | "field_update" | "agent_run" | "workflow_action" | "created"
  channel    String? // "email" | "sms" | "call" | "system" — drives the journey view's icon
  summary    String // one-line human-readable description
  detail     String? // JSON-encoded extra payload
  occurredAt DateTime @default(now())

  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

// Event-triggered automation. v1 is a rule list (not a visual canvas by
// design — see the workflow builder page for why), evaluated synchronously
// the moment its trigger event happens. There is no background job/queue
// infrastructure in this app, so a delay/time-based trigger is explicitly
// NOT supported yet — only immediate, event-based triggers are.
model WorkflowRule {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  isActive      Boolean  @default(true)
  triggerType   String // "lead_created" | "stage_changed" | "field_updated" | "tag_added"
  triggerConfig String   @default("{}") // JSON — e.g. {"toStageId": "..."} for stage_changed
  conditions    String   @default("[]") // JSON-encoded array of {field, operator, value}
  actions       String // JSON-encoded array of {type, config} — see lib/workflow-engine.ts
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runLogs       WorkflowRunLog[]
}

model WorkflowRunLog {
  id         String   @id @default(cuid())
  workflowId String
  leadId     String?
  status     String // "success" | "error"
  detail     String // human-readable summary of what happened
  createdAt  DateTime @default(now())

  workflow   WorkflowRule @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  lead       Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
}
