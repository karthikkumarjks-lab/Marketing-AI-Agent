# Copy this file to .env.local and fill in your own key. .env.local is
# gitignored — it will never be committed or pushed to GitHub.

# RECOMMENDED — Google's own Gemini API, called directly (not through
# OpenRouter). Get a free key at https://aistudio.google.com/apikey — no
# credit card required. Checked before adding this: Google's free-tier daily
# limit for Flash-tier models is far above OpenRouter's 50-requests-per-day
# cap (the exact number is per-project, visible at
# https://aistudio.google.com/rate-limit once you have a key). If this is
# set, it's used automatically ahead of OPENROUTER_API_KEY below — no
# toggle needed.
GEMINI_API_KEY=

# Optional — overrides the default Gemini model (gemini-2.5-flash).
GEMINI_MODEL=

# Get a key at https://openrouter.ai/keys (has free-tier models available,
# capped at 50 requests/day total across all free models on that account).
# Without this AND without GEMINI_API_KEY above, wired agents return a
# clearly labeled demo/mock output.
OPENROUTER_API_KEY=

# Optional — overrides the default free model (minimax/minimax-m3:free).
# Free-model availability on OpenRouter shifts over time — shared-pool rate
# limits, models getting deprecated. If runs start failing with a 429 or
# "model not found," check https://openrouter.ai/models?max_price=0 for a
# current free option and set it here instead of touching code.
OPENROUTER_MODEL=

# Optional — integration connector credentials (see lib/integrations.ts and
# the Integrations tab in any workspace). None of these are required; without
# them the connector cards just show "no OAuth app registered yet".
#
# META_APP_ID/META_APP_SECRET are the one exception with a REAL OAuth flow
# wired up (app/api/integrations/meta/*) — setting these actually enables
# "Connect with Meta" on the Integrations page. Register an app at
# https://developers.facebook.com/apps/, add the Marketing API product, and
# set its "Valid OAuth Redirect URIs" to `${APP_BASE_URL}/api/integrations/meta/callback`.
# Meta enforces HTTPS on redirect URIs with no documented localhost exception
# (confirmed against Meta's own docs, 2026-08-26) — for local testing, point
# an HTTPS tunnel (e.g. `ngrok http 3000`) at this app and set APP_BASE_URL
# to the tunnel's https:// URL below, not http://localhost:3000.
#
# The other 4 (Google Ads, GA4, HubSpot, Salesforce) are scaffolding only —
# setting these does NOT turn on a live connection; the actual OAuth
# authorize/callback routes for those are still a follow-up build.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
GA4_CLIENT_ID=
GA4_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# Required for Meta OAuth's redirect_uri construction. Defaults to
# http://localhost:3000 if unset, which will NOT work with Meta (see above) —
# set this to your HTTPS tunnel URL (e.g. https://abc123.ngrok-free.app) when
# testing the Meta connection locally.
APP_BASE_URL=

# REQUIRED — every page and API route in this app requires a real login
# (see auth.ts, middleware.ts). This secret signs session JWTs; without it
# NextAuth throws at runtime. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it the same across restarts/deploys — changing it logs everyone out.
AUTH_SECRET=
