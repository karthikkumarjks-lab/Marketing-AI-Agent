# Copy this file to .env.local and fill in your own key. .env.local is
# gitignored — it will never be committed or pushed to GitHub.

# Get a key at https://openrouter.ai/keys (has free-tier models available).
# Without this, wired agents return a clearly labeled demo/mock output.
OPENROUTER_API_KEY=

# Optional — integration connector credentials (see lib/integrations.ts and
# the Integrations tab in any workspace). None of these are required; without
# them the connector cards just show "no OAuth app registered yet". Setting
# these does NOT turn on a live connection by itself — the actual OAuth
# authorize/callback routes are still a follow-up build, tracked as such.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
GA4_CLIENT_ID=
GA4_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
